table FactNearest
	lineageTag: 917aa7df-27a4-4a51-ab01-a03343611d41

	column fips
		dataType: string
		lineageTag: a0f4e1e4-1e2d-4522-b8d8-6d808b55f0c2
		summarizeBy: none
		sourceColumn: fips

		annotation SummarizationSetBy = Automatic

	column rank
		dataType: int64
		formatString: 0
		lineageTag: 92440117-7fc0-46f6-bf50-457a56f69557
		summarizeBy: sum
		sourceColumn: rank

		annotation SummarizationSetBy = Automatic

	column site_id
		dataType: string
		lineageTag: a1ee2d6d-26eb-4405-9dce-91bdc166b464
		summarizeBy: none
		sourceColumn: site_id

		annotation SummarizationSetBy = Automatic

	column site_name
		dataType: string
		lineageTag: a0af229d-254d-4ee8-bf6d-8afdecf32a3a
		summarizeBy: none
		sourceColumn: site_name

		annotation SummarizationSetBy = Automatic

	column site_city
		dataType: string
		lineageTag: 71ee5438-a400-441e-a558-77359d249b0f
		summarizeBy: none
		sourceColumn: site_city

		annotation SummarizationSetBy = Automatic

	column site_fips
		dataType: string
		lineageTag: c01aa7f7-31db-4e35-919c-54718854187b
		summarizeBy: none
		sourceColumn: site_fips

		annotation SummarizationSetBy = Automatic

	column site_locality
		dataType: string
		lineageTag: b7738522-a9dc-4b39-8258-ab0d783d3096
		summarizeBy: none
		sourceColumn: site_locality

		annotation SummarizationSetBy = Automatic

	column miles
		dataType: double
		formatString: 0.0" mi"
		lineageTag: 348cd0d8-1212-4f80-abdf-b072292465ef
		summarizeBy: none
		sourceColumn: miles

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Site Label' =
			
			FactNearest[site_name]
			    & UNICHAR ( 10 )
			    & FactNearest[site_city] & " · " & FactNearest[site_locality]
		lineageTag: 8bee283d-82d4-4f81-b2af-8b7966c0b1a4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition FactNearest = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "nearest_sites.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(
				        #"Promoted Headers",
				        {
				            {"fips", type text},
				            {"rank", Int64.Type},
				            {"site_id", type text},
				            {"site_name", type text},
				            {"site_city", type text},
				            {"site_fips", type text},
				            {"site_locality", type text},
				            {"miles", type number}
				        }
				    )
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

