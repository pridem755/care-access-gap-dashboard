			    "Choose a locality"
			)
		displayFolder: 7 Locality Page
		lineageTag: ff2bc442-96fa-489c-8c42-1dac964d9570

	measure 'Chip Area' =
			
			VAR areaType = SELECTEDVALUE ( DimGeography[metro_status] )
			RETURN
			    IF (
