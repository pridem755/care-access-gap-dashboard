	measure 'Part Dot' =
			
			VAR v = [Part Value]
			VAR lo = [Part VA Min]
			VAR hi = [Part VA Max]
			VAR med = [Part VA Median]
			VAR lineStart = 6
			VAR lineLength = 108
			VAR lineEnd = lineStart + lineLength
			VAR dotX = FORMAT ( lineStart + DIVIDE ( v - lo, hi - lo ) * lineLength, "0.0" )
			VAR medX = FORMAT ( lineStart + DIVIDE ( med - lo, hi - lo ) * lineLength, "0.0" )
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='16'>"
			            & "<line x1='" & lineStart & "' y1='8' x2='" & lineEnd & "' y2='8' stroke='%23E3E8EE' stroke-width='3' stroke-linecap='round'/>"
			            & "<line x1='" & medX & "' y1='3' x2='" & medX & "' y2='13' stroke='%2366717F' stroke-width='2'/>"
			            & "<circle cx='" & dotX & "' cy='8' r='5' fill='%23B45309'/>"
			            & "</svg>"
			    )
		displayFolder: 7 Locality Page
		lineageTag: dfc1a873-8541-42e5-a93f-02b2d6663f1e
		dataCategory: ImageUrl

	measure 'Part Value Text' =
			
			VAR v = [Part Value]
			VAR ind = SELECTEDVALUE ( 'Score Parts'[Indicator] )
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        IF (
			            ind = "Few or no health centers",
			            FORMAT ( v, "0.0" ),
			            IF ( v <= 1, FORMAT ( v, "0.0%" ), FORMAT ( v, "0.0" ) & "%" )
			        )
			    )
		displayFolder: 7 Locality Page
		lineageTag: 7420da6a-e4b9-4daf-b382-64ba5595c5e4

	measure 'Part Median Text' =
			
			VAR m = [Part VA Median]
			VAR ind = SELECTEDVALUE ( 'Score Parts'[Indicator] )
			RETURN
			    IF (
			        NOT ISBLANK ( m ),
			        IF (
			            ind = "Few or no health centers",
			            FORMAT ( m, "0.0" ),
			            IF ( m <= 1, FORMAT ( m, "0.0%" ), FORMAT ( m, "0.0" ) & "%" )
			        )
			    )
		displayFolder: 7 Locality Page
		lineageTag: 729dd3fc-c8ff-4fc3-a8a4-5ac120fcb612

	measure 'Locality Short Name' =
			
			VAR n = SELECTEDVALUE ( DimGeography[locality_name] )
			RETURN
			    IF (
			        HASONEVALUE ( DimGeography[fips] ),
			        SUBSTITUTE ( SUBSTITUTE ( n, " County", "" ), " city", "" )
			    )
		displayFolder: 7 Locality Page
		lineageTag: c1d6309a-434c-4f3e-a8c0-340d240d3807

	measure 'Compare Subtitle' =
			
			IF (
			    HASONEVALUE ( DimGeography[fips] ),
			    [Locality Short Name] & " figures vs. Virginia median"
			)
		displayFolder: 7 Locality Page
		lineageTag: 92993913-88db-4821-b3b2-8e2b0910cbe1

	measure 'Compare Key' =
			
			VAR nm = [Locality Short Name]
			VAR charW = 7.2
			VAR nameStart = 18
			VAR nameEnd = nameStart + LEN ( nm ) * charW
			VAR tickX = nameEnd + 14
			VAR medTextX = tickX + 8
			VAR lineStart = medTextX + 12 * charW + 14
			VAR lineEnd = lineStart + 24
			VAR rangeTextX = lineEnd + 8
			RETURN
			    IF (
			        HASONEVALUE ( DimGeography[fips] ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' width='420' height='22'>"
			            & "<circle cx='7' cy='11' r='6' fill='%23B45309'/>"
			            & "<text x='" & nameStart & "' y='16' font-family='Segoe UI' font-size='13' fill='%2366717F'>" & nm & "</text>"
			            & "<line x1='" & FORMAT ( tickX, "0" ) & "' y1='4' x2='" & FORMAT ( tickX, "0" ) & "' y2='18' stroke='%2366717F' stroke-width='2'/>"
			            & "<text x='" & FORMAT ( medTextX, "0" ) & "' y='16' font-family='Segoe UI' font-size='13' fill='%2366717F'>State median</text>"
			            & "<line x1='" & FORMAT ( lineStart, "0" ) & "' y1='11' x2='" & FORMAT ( lineEnd, "0" ) & "' y2='11' stroke='%23D5DBE2' stroke-width='3' stroke-linecap='round'/>"
			            & "<text x='" & FORMAT ( rangeTextX, "0" ) & "' y='16' font-family='Segoe UI' font-size='13' fill='%2366717F'>Range of 133</text>"
			            & "</svg>"
			    )
		displayFolder: 7 Locality Page
		lineageTag: 941f4dab-ee21-4a0d-991e-2d79e87a48c9
		dataCategory: ImageUrl

	measure 'Nearest Miles' =
			
			CALCULATE ( MIN ( FactNearest[miles] ), FactNearest[rank] = 1 )
		displayFolder: 7 Locality Page
		lineageTag: f834630e-07e5-4f0e-afdc-42a3d7a6d1dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Access Alert' =
			
			VAR place = [Locality Name]
			VAR sites = [Supply Locations] + 0
			VAR nearest = FORMAT ( [Nearest Miles], "0.0" )
			RETURN
			    IF (
			        HASONEVALUE ( DimGeography[fips] ),
			        IF (
			            sites = 0,
			            place & " has no counted health center location.",
			            place & " has " & sites
			                & IF ( sites = 1, " counted health center location", " counted health center locations" )
			                & ". Nearest: " & nearest & " mi."
			        )
			    )
		displayFolder: 7 Locality Page
		lineageTag: e33f1021-4d30-49da-83fe-2e17cbfb339c

	measure 'Access Alert Background' =
			
			IF ( [Supply Locations] + 0 = 0, "#FDF0E1", "#EEF3F8" )
		displayFolder: 7 Locality Page
		lineageTag: cf9869f9-caba-4bb5-a841-5823ba4c838f

	measure 'Access Alert Text Color' =
			
			IF ( [Supply Locations] + 0 = 0, "#8A4B0F", "#1F5182" )
		displayFolder: 7 Locality Page
		lineageTag: 26f95369-9500-4872-88cc-3e35695faaed

	measure 'Distance Note' =
			
			IF (
			    HASONEVALUE ( DimGeography[fips] ),
			    "Straight-line miles from the center of where "
			        & [Locality Name]
			        & " residents live."
			)
		displayFolder: 7 Locality Page
		lineageTag: b6aec957-2568-458e-b53f-667977a433f9

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

