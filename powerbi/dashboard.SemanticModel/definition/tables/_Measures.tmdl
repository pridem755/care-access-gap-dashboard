			    "#66717F"
			)
		lineageTag: 4b77ed72-c9be-46a2-b4de-9a83677712f6

	measure 'Gap Score Bar' =
			
			VAR score = [Access Gap Score]
			VAR imgWidth = 95
			VAR imgHeight = 16
			VAR trackWidth = 62
			VAR barHeight = 4
			VAR barTop = ( imgHeight - barHeight ) / 2
			VAR fillWidth = DIVIDE ( score, 100 ) * trackWidth
			RETURN
			    IF (
			        NOT ISBLANK ( score ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' width='" & imgWidth
			            & "' height='" & imgHeight & "'>"
			            & "<rect x='0' y='" & barTop & "' width='" & trackWidth
			            & "' height='" & barHeight & "' rx='2' fill='%23E3E8EE'/>"
			            & "<rect x='0' y='" & barTop & "' width='" & FORMAT ( fillWidth, "0.0" )
			            & "' height='" & barHeight & "' rx='2' fill='%231F5182'/>"
			            & "<line x1='" & trackWidth & "' y1='3' x2='" & trackWidth
			            & "' y2='13' stroke='%2366717F' stroke-width='1'/>"
			            & "<text x='" & imgWidth - 1 & "' y='12' text-anchor='end' "
			            & "font-family='Segoe UI, sans-serif' font-size='11' fill='%2317212B'>"
			            & FORMAT ( score, "0" ) & "</text>"
			            & "</svg>"
			    )
		lineageTag: 85fffccc-507e-499c-9a01-b317a2f65d78
		dataCategory: ImageUrl

	measure 'Part Percentile' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Score Parts'[Indicator] ),
			    "No health insurance", SELECTEDVALUE ( DimGeography[Uninsured Pctl] ),
			    "Living in poverty", SELECTEDVALUE ( DimGeography[Poverty Pctl] ),
			    "Diabetes", SELECTEDVALUE ( DimGeography[Diabetes Pctl] ),
			    "High blood pressure", SELECTEDVALUE ( DimGeography[High BP Pctl] ),
			    "Few or no health centers", SELECTEDVALUE ( DimGeography[Supply Gap Pctl] )
			)
		displayFolder: 7 Locality Page
		lineageTag: e774ee1e-3ae3-402c-b4c9-df412956e4ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Part Weight' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Score Parts'[Indicator] ),
			    "No health insurance", [Weight Uninsured Value],
			    "Living in poverty", [Weight Poverty Value],
			    "Diabetes (adults)", [Weight Diabetes Value],
			    "High blood pressure (adults)", [Weight High BP Value],
			    "Few or no health centers", [Weight Supply Value]
			)
		formatString: 0
		displayFolder: 7 Locality Page
		lineageTag: 767fa07b-6011-4be8-a5aa-1937900e8370

	measure 'Part Detail' =
			
			IF (
			    NOT ISBLANK ( [Part Percentile] ),
			    FORMAT ( [Part Percentile], "0" ) & " of 100"
			)
		displayFolder: 7 Locality Page
		lineageTag: 6b57eb0d-bd1a-4ba9-9701-8084dea9d764

	measure 'Part Bar' =
			
			VAR score = [Part Percentile]
			VAR fillWidth = FORMAT ( DIVIDE ( score, 100 ) * 160, "0.0" )
			RETURN
			    IF (
			        NOT ISBLANK ( score ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' width='200' height='20'>"
			            & "<rect x='0' y='6' width='160' height='8' rx='4' fill='%23EEF1F4'/>"
			            & "<rect x='0' y='6' width='" & fillWidth & "' height='8' rx='4' fill='%231F5182'/>"
			            & "<text x='200' y='15' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='%23252A31'>"
			            & FORMAT ( score, "0" )
			            & "</text></svg>"
			    )
		displayFolder: 7 Locality Page
		lineageTag: e0c1562c-485a-4862-8eba-86957b9c5e1e
		dataCategory: ImageUrl

	measure 'Locality Facts Text' =
			
			VAR sites = [Supply Locations] + 0
			RETURN
			    IF (
			        HASONEVALUE ( DimGeography[fips] ),
			        SELECTEDVALUE ( DimGeography[locality_type] )
			            & "  ·  "
			            & SELECTEDVALUE ( DimGeography[metro_status] )
			            & "  ·  "
			            & FORMAT ( [Population], "#,0" ) & " residents"
			            & "  ·  "
			            & sites
			            & IF ( sites = 1, " health center location", " health center locations" )
			    )
		isHidden
		lineageTag: f56c2eb0-313f-4c42-b084-faf63f3e9418

		changedProperty = IsHidden

	measure 'Locality Name' =
			
			IF (
			    HASONEVALUE ( DimGeography[fips] ),
